# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Public (inlined into the client bundle at build time; safe to expose) ----
# These are also read during SSR. Both are required.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Secrets ----
# Nothing in this app currently needs a server-only Supabase key: all data access
# goes through the browser client and is enforced by RLS. If you add a server
# function that must bypass RLS, set SUPABASE_SERVICE_ROLE_KEY as a Cloudflare
# *secret* (`wrangler secret put SUPABASE_SERVICE_ROLE_KEY`) — not as a `vars`
# entry in wrangler.jsonc, which is plaintext in the deployed Worker.
# Do NOT prefix it with VITE_ or it will be inlined into the client bundle.
# SUPABASE_SERVICE_ROLE_KEY=
